#!/bin/sh

APP_DIR="$HOME/.logbook"
GLOBAL_LINK="$APP_DIR/current"
INDEX_FILE="$APP_DIR/logbooks.md"
HOME_LINK="$HOME/logbook.md"
LOG_FILE="$GLOBAL_LINK/logbook.md"

get_datetime() {
    date +"%Y-%m-%d %H:%M:%S"
}

ensure_app_dir() {
    mkdir -p "$APP_DIR"
}

ensure_logbook_open() {
    if [ ! -f "$LOG_FILE" ]; then
        echo "Error: No open logbook found at $GLOBAL_LINK" >&2
        exit 1
    fi
}

case "$1" in
    new)
        ensure_app_dir
        TEMPLATE_NAME="${2:-template}"
        case "$TEMPLATE_NAME" in
            *.md) TEMPLATE_FILE="$APP_DIR/$TEMPLATE_NAME" ;;
            *) TEMPLATE_FILE="$APP_DIR/${TEMPLATE_NAME}.md" ;;
        esac

        # Create minimal default template if 'template' is requested and does not exist
        if [ "$TEMPLATE_NAME" = "template" ] && [ ! -f "$TEMPLATE_FILE" ]; then
            cat << 'EOF' > "$TEMPLATE_FILE"
# Logbook @LOGBOOK_TITLE@

- Created: @CREATION_TIME@
- Path: @LOGBOOK_PATH@

---

EOF
        fi

        if [ ! -f "$TEMPLATE_FILE" ]; then
            echo "Error: Template file '$TEMPLATE_FILE' does not exist." >&2
            exit 1
        fi

        mkdir -p ./logbook
        NOW=$(get_datetime)
        ABS_PATH="$(pwd)/logbook"
        TARGET_LOGBOOK="./logbook/logbook.md"

        # Pass 1: Replace reserved automatic variables (@CREATION_TIME@, @LOGBOOK_PATH@)
        sed -e "s/@CREATION_TIME@/$NOW/g" \
            -e "s|@LOGBOOK_PATH@|$ABS_PATH|g" \
            "$TEMPLATE_FILE" > "$TARGET_LOGBOOK"

        # Pass 2: Interactively prompt for remaining @PLACEHOLDER@ variables
        PLACEHOLDERS=$(grep -o '@[A-Z0-9_]\{1,\}@' "$TARGET_LOGBOOK" 2>/dev/null | tr -d '@' | sort -u)

        for VAR in $PLACEHOLDERS; do
            printf "%s: " "$VAR"
            if [ -c /dev/tty ]; then
                read -r VALUE < /dev/tty
            else
                read -r VALUE
            fi

            SAFE_VALUE=$(echo "$VALUE" | sed -e 's/[\/&]/\\&/g')
            sed -e "s/@${VAR}@/${SAFE_VALUE}/g" "$TARGET_LOGBOOK" > "$TARGET_LOGBOOK.tmp" && mv "$TARGET_LOGBOOK.tmp" "$TARGET_LOGBOOK"
        done

        # Open the new logbook
        "$0" open

        # Update logbooks index
        touch "$INDEX_FILE"
        if ! grep -F -q "$ABS_PATH" "$INDEX_FILE" 2>/dev/null; then
            echo "- [$NOW] [$ABS_PATH](file://$ABS_PATH/logbook.md)" >> "$INDEX_FILE"
        fi
        ;;
    open)
        if [ ! -d ./logbook ]; then
            echo "Error: ./logbook directory does not exist. Run 'logbook new' first." >&2
            exit 1
        fi
        ensure_app_dir
        ABS_LOGBOOK="$(pwd)/logbook"

        # Update ~/logbook.md symlink
        if [ -e "$HOME_LINK" ] && [ ! -L "$HOME_LINK" ]; then
            echo "Error: $HOME_LINK exists and is a regular file." >&2
            exit 1
        fi      
        rm -f "$GLOBAL_LINK"
        ln -s "$ABS_LOGBOOK" "$GLOBAL_LINK"
        rm -f "$HOME_LINK"
        ln -s "$GLOBAL_LINK/logbook.md" "$HOME_LINK"
        ;;
    log)
        shift
        ensure_logbook_open
        DATETIME=$(get_datetime)

        if [ $# -gt 0 ]; then
            MESSAGE="$*"
            LINES=$(printf "%s\n" "$MESSAGE" | wc -l)
            if [ "$LINES" -gt 1 ]; then
                printf "%s:\n\n%s\n\n" "$DATETIME" "$MESSAGE" >> "$LOG_FILE"
            else
                printf "%s: %s\n" "$DATETIME" "$MESSAGE" >> "$LOG_FILE"
            fi
        else
            if [ -t 0 ]; then
                echo "Error: No message provided and stdin is an interactive terminal." >&2
                exit 1
            fi
            STDIN_CONTENT=$(cat)
            if [ -n "$STDIN_CONTENT" ]; then
                printf "%s:\n\n%s\n\n" "$DATETIME" "$STDIN_CONTENT" >> "$LOG_FILE"
            fi
        fi
        ;;
    run)
        shift
        CMD_STR="$*"
        if [ -z "$CMD_STR" ]; then
            echo "Error: No command specified." >&2
            exit 1
        fi

        ensure_logbook_open
        START_DATETIME=$(get_datetime)

        # Log start entry
        printf "%s: Running %s\n" "$START_DATETIME" "$CMD_STR" >> "$LOG_FILE"

        TMP_OUT=$(mktemp 2>/dev/null || echo "/tmp/logbook_run_out_$$")
        TMP_STATUS=$(mktemp 2>/dev/null || echo "/tmp/logbook_run_status_$$")

        (
            "$@"
            echo $? > "$TMP_STATUS"
        ) 2>&1 | tee "$TMP_OUT"

        EXIT_CODE=$(cat "$TMP_STATUS" 2>/dev/null || echo 0)
        END_DATETIME=$(get_datetime)

        cat << EOF >> "$LOG_FILE"
<details><summary>${END_DATETIME}: finished with code ${EXIT_CODE}</summary>

\`\`\`
$(cat "$TMP_OUT")
\`\`\`
</details>
EOF

        rm -f "$TMP_OUT" "$TMP_STATUS"
        ;;
    "")
        if [ -L "$GLOBAL_LINK" ] || [ -d "$GLOBAL_LINK" ]; then
            REAL_PATH=$(readlink "$GLOBAL_LINK" 2>/dev/null || ls -ld "$GLOBAL_LINK" 2>/dev/null | sed 's/.* -> //')
            if [ -z "$REAL_PATH" ]; then
                REAL_PATH="$GLOBAL_LINK"
            fi
            echo "Open logbook: $REAL_PATH/logbook.md"
        else
            echo "No open logbook"
        fi
        echo "Usage: logbook [new [template]|open|log <message>|run <command>]"
        ;;
    *)
        echo "Usage: logbook [new [template]|open|log <message>|run <command>]" >&2
        exit 1
        ;;
esac
